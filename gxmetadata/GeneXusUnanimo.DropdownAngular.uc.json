{
	"DefinitionVersion": "1.0",
	"Name": "GeneXusUnanimo.DropdownAngular",
	"Target": "ANGULAR",
	"IsControlType": false,
	"RenderMode": "component",
	"Template": "{{=<% %>=}}<div class=\"dropdown\"    (mouseover)=\"doMouseover()\"     (mouseout)=\"doMouseout()\"    (click)=\"doOpen()\"	aria-haspopup=\"true\"	[attr.aria-expanded]=\"Open ? true: false\">    <div class=\"dd-flex-container\">        <div *ngIf=\"ShowVerticalSeparator\" class=\"dd-vertical-separator\"></div>        <div *ngIf=\"UserFullName && DisplayType === \'Text\' || DisplayType === \'Avatar and Text\'\"        class=\"dd-text-container\">            <div class=\"row\"> <span class=\"dd-username\">{{UserFullName}}</span> </div>            <div class=\"row\"> <span class=\"dd-companyname\">{{UserCompany}}</span> </div>        </div>        <div *ngIf=\"DisplayType === \'Avatar\' || DisplayType === \'Avatar and Text\' || DisplayType === \'Text into options box\'\"        class=\"dd-avatar-container\" id=\"imgContainer\"> 			<img *ngIf=\"UserPhoto\" [attr.src]=\"UserPhoto\" class=\"dd-avatar\">		</div>    </div>    <div [ngClass]=\"{\'dropdown-content\':true,\'dropdown-content--visible\':Open}\" role=\"list\">        <div *ngIf=\"DisplayType === \'Text into options box\'\" class=\"dd-text-container\">            <div class=\"row\"> <span class=\"dd-username\">{{UserFullName}}</span> </div>            <div class=\"row\"> <span class=\"dd-companyname\">{{UserCompany}}</span> </div>        </div>        <ng-container *ngFor=\"let dropItem of DropdownItems\">            <div *ngIf=\"dropItem.separator\" class=\"dd-dropdown-separator\"></div>            <div id=\"{{dropItem.id}}\" class=\"dd-option-container\" [ngClass]=\"{\'dd-option--selected\':SelectedItemId === dropItem.id}\"                (click)=\"SelectedItemId=dropItem.id; SelectedItemTarget=dropItem.link; ItemClick();\"				role=\"listitem\"			> 				<img alt=\"{{dropItem.alternativeText}}\" class=\"dd-option-icon\" src=\"{{dropItem.icon}}\"> 				<span class=\"dd-option\">{{dropItem.title}}</span>			</div>        </ng-container> <!-- default logout event -->        <div *ngIf=\"ShowLogoutOption\" class=\"dd-option-container\" (click)=\"this.handleLogout($event)\"> <img                alt=\"logout_icon\" class=\"dd-option-icon\" src=\"{{LogoutIcon}}\"> <span class=\"dd-option\">Logout</span>        </div>    </div></div><div [ngClass]=\"{\'dd-overlay dd-overlay--visible\':Open}\" (click)=\"doOpen()\"></div>", 
	"Subtemplates": [
	],
	"Events": [
		{
			"Name": "Logout",
			"On": "click",
			"Parameters": ""
		} ,
		{
			"Name": "ItemClick",
			"On": "itemclick",
			"Parameters": ""
		} 
	],
	"Properties": [
		{
			"Id": "UserPhoto",
			"Name": "UserPhoto",
			"Type": "string",
			"Collection": "false",
			"Default": ""
		} ,
		{
			"Id": "UserFullName",
			"Name": "UserFullName",
			"Type": "string",
			"Collection": "false",
			"Default": ""
		} ,
		{
			"Id": "UserCompany",
			"Name": "UserCompany",
			"Type": "string",
			"Collection": "false",
			"Default": ""
		} ,
		{
			"Id": "DisplayType",
			"Name": "DisplayType",
			"Type": "enum",
			"Collection": "false",
			"Default": "Avatar"
		} ,
		{
			"Id": "ExpandBehavior",
			"Name": "ExpandBehavior",
			"Type": "enum",
			"Collection": "false",
			"Default": "Hover"
		} ,
		{
			"Id": "ShowVerticalSeparator",
			"Name": "ShowVerticalSeparator",
			"Type": "boolean",
			"Collection": "false",
			"Default": "true"
		} ,
		{
			"Id": "ShowLogoutOption",
			"Name": "ShowLogoutOption",
			"Type": "boolean",
			"Collection": "false",
			"Default": "true"
		} ,
		{
			"Id": "DropdownItems",
			"Name": "DropdownItems",
			"Type": "sdt",
			"Collection": "false",
			"Default": ""
		} ,
		{
			"Id": "SelectedItemId",
			"Name": "SelectedItemId",
			"Type": "string",
			"Collection": "false",
			"Default": ""
		} ,
		{
			"Id": "SelectedItemTarget",
			"Name": "SelectedItemTarget",
			"Type": "string",
			"Collection": "false",
			"Default": ""
		} ,
		{
			"Id": "LogoutIcon",
			"Name": "LogoutIcon",
			"Type": "string",
			"Collection": "false",
			"Default": ""
		} ,
		{
			"Id": "Open",
			"Name": "Open",
			"Type": "boolean",
			"Collection": "false",
			"Default": ""
		} 
	],
	"Methods": {
		"Public": [
			{
				"Name": "doOpen",
				"Source": "    if (this.ExpandBehavior === \'Click\') {      this.Open = ! this.Open;    }  ",
				"Return": "",
				"IsAsync": false,
				"IsArrowFn": false,
				"Parameters": [
				]
			} ,
			{
				"Name": "doMouseover",
				"Source": "    if (this.ExpandBehavior === \'Hover\') {      this.Open = true;    }  ",
				"Return": "",
				"IsAsync": false,
				"IsArrowFn": false,
				"Parameters": [
				]
			} ,
			{
				"Name": "doMouseout",
				"Source": "    if (this.ExpandBehavior === \'Hover\') {      this.Open = false;    }  ",
				"Return": "",
				"IsAsync": false,
				"IsArrowFn": false,
				"Parameters": [
				]
			} 
		],
		"Private": [
		]
	},
	"Scripts": {
		"AfterShow": [
		],
		"BeforeShow": [
		]
	},
	"Dependencies": [
	],
	"Imports": [
	],
	"Styles": [
	],
	"Sources": [
	]
}